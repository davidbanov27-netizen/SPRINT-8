<Window x:Class="SchoolLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SchoolLibrary.ViewModels"
        xmlns:views="clr-namespace:SchoolLibrary.Views"
        Title="Училищна библиотека"
        Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>
        <!-- Всеки ViewModel има свой екран. Така MainViewModel сменя само CurrentPage. -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CatalogViewModel}"><views:CatalogView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReadersViewModel}"><views:ReadersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoanViewModel}"><views:LoanView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReturnViewModel}"><views:ReturnView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverdueViewModel}"><views:OverdueView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsViewModel}"><views:StatsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}"><views:SearchView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecsViewModel}"><views:RecsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MyBooksViewModel}"><views:MyBooksView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="200" Background="{StaticResource SideBrush}"
                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,14">
                    <TextBlock Text="📚 Библиотека" Foreground="#FBD38D" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding UserTitle}" Foreground="White" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding UserMode}" Foreground="#E7CDB8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Изход" Command="{Binding LogoutCommand}"
                        Margin="16" Background="Transparent" BorderBrush="#F3B8A8" Foreground="#F9D5C9"/>

                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav}"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="17" Width="30"/>
                                <TextBlock Text="{Binding Title}" FontSize="14.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Предупреждение за съхранението на данните (повреден файл, неуспешен запис) -->
            <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="0,0,0,1" Padding="18,10"
                    Visibility="{Binding HasStorageNotice, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Разбрах" Command="{Binding DismissNoticeCommand}"
                            Margin="12,0,0,0" Padding="12,4"/>
                    <TextBlock Text="{Binding StorageNotice}" Foreground="#92400E" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>
</Window>
