<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тема „Rose“ (Читатели). Всеки екран подава свои цветове; стиловете в Styles.xaml ги четат с DynamicResource. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#BE185D"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#941349"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F8E8EF"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#E6A7C1"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#851141"/>
    <SolidColorBrush x:Key="InfoBg" Color="#F8E8EF"/>
    <SolidColorBrush x:Key="InfoBorder" Color="#E6A7C1"/>
</ResourceDictionary>
