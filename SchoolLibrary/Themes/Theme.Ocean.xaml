<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тема „Ocean“ (Връщане). Всеки екран подава свои цветове; стиловете в Styles.xaml ги четат с DynamicResource. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0E7490"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#0B5A70"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E7F1F4"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#A3CAD5"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#0A5165"/>
    <SolidColorBrush x:Key="InfoBg" Color="#E7F1F4"/>
    <SolidColorBrush x:Key="InfoBorder" Color="#A3CAD5"/>
</ResourceDictionary>
