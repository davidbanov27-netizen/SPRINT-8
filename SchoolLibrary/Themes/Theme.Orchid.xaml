<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тема „Orchid“ (Препоръки). Всеки екран подава свои цветове; стиловете в Styles.xaml ги четат с DynamicResource. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#C026D3"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#961EA5"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F9E9FB"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#E7ADEE"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#861B94"/>
    <SolidColorBrush x:Key="InfoBg" Color="#F9E9FB"/>
    <SolidColorBrush x:Key="InfoBorder" Color="#E7ADEE"/>
</ResourceDictionary>
