<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тема „Honey“ (Табло / вход). Всеки екран подава свои цветове; стиловете в Styles.xaml ги четат с DynamicResource. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#A95D05"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FBF1E6"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#F1CBA0"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#985304"/>
    <SolidColorBrush x:Key="InfoBg" Color="#FBF1E6"/>
    <SolidColorBrush x:Key="InfoBorder" Color="#F1CBA0"/>
</ResourceDictionary>
