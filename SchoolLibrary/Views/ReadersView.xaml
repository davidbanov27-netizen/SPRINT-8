<UserControl x:Class="SchoolLibrary.Views.ReadersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchoolLibrary.Views">
    <UserControl.Resources>
        <ResourceDictionary Source="/Themes/Theme.Rose.xaml"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <Border Style="{StaticResource PageHeader}">
                <StackPanel>
                    <TextBlock Text="👥 Читатели" Style="{StaticResource PageTitle}" Margin="0"/>
                    <TextBlock Text="Учениците и учителите, които ползват библиотеката." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </Border>
            <local:MessageBanner/>

            <StackPanel Orientation="Horizontal">
                <TextBox Width="320" Margin="0,0,10,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Търси по име, читателски номер или клас"/>
                <Button Content="+ Нов читател" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"/>
            </StackPanel>

            <!-- Форма за нов читател и за редактиране -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding FormHeading}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Читателски номер" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CardNumberText, Mode=OneWay}" IsReadOnly="True" Background="#F3F4F6"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Име *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0"
                                    Visibility="{Binding IsStudent, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Клас * (напр. 7Б)" Style="{StaticResource FieldLabel}"/>
                            <TextBox MinWidth="120" Width="120" Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Контакт (по избор)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Имейл или телефон"/>
                        </StackPanel>
                    </WrapPanel>
                    <CheckBox Content="Учител" IsChecked="{Binding IsTeacher}" Margin="0,12,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Отказ" Command="{Binding CancelCommand}"/>
                        <Button Content="Запази" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Читатели" Style="{StaticResource SectionTitle}"/>
            <DataGrid ItemsSource="{Binding Readers}" SelectedItem="{Binding SelectedReader}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Номер" Binding="{Binding CardNumber}" Width="100" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Име" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Клас / роля" Binding="{Binding ClassName}" Width="*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Заети" Binding="{Binding LoansText}" Width="80" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTemplateColumn Header="Статус" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource ReaderStatusText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Подробности за избрания читател -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedReader.Name}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                        <Run Text="Номер "/>
                        <Run Text="{Binding SelectedReader.CardNumber, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding SelectedReader.ClassName, Mode=OneWay}"/>
                        <Run Text=" · Контакт: "/>
                        <Run Text="{Binding SelectedReader.Contact, Mode=OneWay}"/>
                    </TextBlock>

                    <StackPanel Visibility="{Binding HasSelectedLoans, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Заети книги" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                        <DataGrid ItemsSource="{Binding SelectedLoans}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Книга" Binding="{Binding BookTitle}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="110" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Header="Статус" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource LoanStatusText}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Редактирай" Command="{Binding EditCommand}"/>
                        <Button Content="{Binding ToggleActiveText}" Command="{Binding ToggleActiveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
